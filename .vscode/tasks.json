{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "go: run",
            "type": "go",
            "command": "run",
            "args": ["."],
            "group": "none",
            "problemMatcher": ["$go"],
            "options": {
                "cwd": "${workspaceFolder}/stage_mgr_go",
                "env": {
                    "STAGEMANAGER_APP_FILTER": "notepad,mspaint"
                }
            }
        },
        {
            "label": "go: test",
            "type": "go",
            "command": "test",
            "args": ["./..."],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$go"],
            "options": {
                "cwd": "${workspaceFolder}/stage_mgr_go"
            }
        },
        {
            "label": "mygo: vet",
            "type": "shell",
            "command": "go tool mygo vet .",
            "problemMatcher": ["$go"],
            "options": {
                "cwd": "${workspaceFolder}/stage_mgr_go"
            }
        },
        {
            "label": "mygo: build",
            "type": "shell",
            "command": "go tool mygo build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$go"],
            "options": {
                "cwd": "${workspaceFolder}/stage_mgr_go"
            }
        },
        {
            "label": "Stage Manager for Windows: quit running instance",
            "type": "process",
            "command": "${workspaceFolder}/stage_mgr_go/build/windows-amd64/StageManagerForWindows.exe",
            "args": ["--quit"],
            "windows": {
                "command": "${workspaceFolder}/stage_mgr_go/build/windows-amd64/StageManagerForWindows.exe"
            },
            "problemMatcher": []
        }
    ]
}
