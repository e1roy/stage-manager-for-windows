<UserControl x:Class="StageManager.Controls.WindowPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand"
             Focusable="False"
             Background="Transparent">
  <UserControl.RenderTransform>
    <TransformGroup>
      <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
      <TranslateTransform x:Name="CardTranslate" X="0" Y="0" />
    </TransformGroup>
  </UserControl.RenderTransform>

  <!-- One shadowed surface per stacked window is inserted here in code; DWM
       paints each live window exactly into its surface rectangle. -->
  <Canvas x:Name="LayerCanvas">
    <!-- The real badge is rendered in a separate transparent HWND so it can
         stay above DWM thumbnails. This invisible element is its layout anchor. -->
    <Border x:Name="AppIconAnchor"
            Width="30" Height="30"
            Opacity="0"
            IsHitTestVisible="False" />
  </Canvas>
</UserControl>
