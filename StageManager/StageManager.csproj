<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StageBar</AssemblyName>
    <RootNamespace>StageManager</RootNamespace>
    <ApplicationIcon>Assets\stagebar.ico</ApplicationIcon>
    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
    <Product>StageBar</Product>
    <Description>Windows 台前调度与实时窗口预览</Description>
    <Authors>StageBar</Authors>
    <RepositoryUrl>https://github.com/renkai9418/stage-bar</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\stagebar.ico" />
  </ItemGroup>
</Project>
