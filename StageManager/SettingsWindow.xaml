<Window x:Class="StageManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StageBar 设置"
        Icon="Assets/stagebar.ico"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="True">
  <!-- Brushes are Windows' Fluent color tokens, set in code for the current
       light/dark mode and accent color. -->
  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="FocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-3" RadiusX="6" RadiusY="6" StrokeThickness="2"
                       Stroke="{DynamicResource TextPrimary}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="GroupHeader" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="1,28,0,8" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="MinHeight" Value="68" />
    </Style>

    <Style x:Key="CardIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Margin" Value="2,0,20,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardDescription" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="StateText" Text="关" Margin="0,0,12,0" VerticalAlignment="Center" />
              <Border x:Name="Track" Grid.Column="1" Width="40" Height="20" CornerRadius="10"
                      BorderThickness="1"
                      Background="{DynamicResource ControlAltFill}"
                      BorderBrush="{DynamicResource ControlStrong}" />
              <Grid Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Left">
                <Grid.RenderTransform>
                  <TranslateTransform x:Name="KnobOffset" />
                </Grid.RenderTransform>
                <Ellipse x:Name="Knob" Width="12" Height="12"
                         Fill="{DynamicResource TextSecondary}" />
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ControlAltFillHover}" />
                <Setter TargetName="Knob" Property="Width" Value="14" />
                <Setter TargetName="Knob" Property="Height" Value="14" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Knob" Property="Width" Value="17" />
                <Setter TargetName="Knob" Property="Height" Value="14" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="StateText" Property="Text" Value="开" />
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccent}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobOffset" Storyboard.TargetProperty="X"
                                       To="20" Duration="0:0:0.167">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobOffset" Storyboard.TargetProperty="X"
                                       To="0" Duration="0:0:0.167">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentHover}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentHover}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RadioOption" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="20" Height="20" Margin="0,1,0,0" VerticalAlignment="Top">
                <Ellipse x:Name="Outer" StrokeThickness="1"
                         Fill="{DynamicResource ControlAltFill}"
                         Stroke="{DynamicResource ControlStrong}" />
                <Ellipse x:Name="Dot" Width="0" Height="0"
                         Fill="{DynamicResource TextOnAccent}" />
              </Grid>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Fill" Value="{DynamicResource ControlAltFillHover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Outer" Property="Fill" Value="{DynamicResource Accent}" />
                <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource Accent}" />
                <Setter TargetName="Dot" Property="Width" Value="12" />
                <Setter TargetName="Dot" Property="Height" Value="12" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Outer" Property="Fill" Value="{DynamicResource AccentHover}" />
                <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource AccentHover}" />
                <Setter TargetName="Dot" Property="Width" Value="14" />
                <Setter TargetName="Dot" Property="Height" Value="14" />
              </MultiTrigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True" />
                  <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Dot" Property="Width" Value="10" />
                <Setter TargetName="Dot" Property="Height" Value="10" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SliderTrackPart" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent">
              <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                      Background="{TemplateBinding Foreground}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Width="20" Height="20">
              <Ellipse StrokeThickness="1"
                       Fill="{DynamicResource ControlSolidFill}"
                       Stroke="{DynamicResource ThumbStroke}" />
              <Ellipse x:Name="Inner" Width="12" Height="12" Fill="{DynamicResource Accent}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Inner" Property="Width" Value="14" />
                <Setter TargetName="Inner" Property="Height" Value="14" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Inner" Property="Width" Value="10" />
                <Setter TargetName="Inner" Property="Height" Value="10" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FluentSlider" TargetType="Slider">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="IsSnapToTickEnabled" Value="True" />
      <Setter Property="Width" Value="200" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="32" Background="Transparent">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderTrackPart}"
                                Foreground="{DynamicResource Accent}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SliderThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackPart}"
                                Foreground="{DynamicResource ControlStrong}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SliderValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="MinWidth" Value="52" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="28,12,28,28">
    <TextBlock Text="台前调度" Style="{StaticResource PageTitle}" />

    <TextBlock Text="行为" Style="{StaticResource GroupHeader}" />
    <Border Style="{StaticResource Card}" Padding="0">
      <StackPanel>
        <Grid Margin="16,0" MinHeight="66">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE7C4;" Style="{StaticResource CardIcon}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="展示形式" />
            <TextBlock Text="选择侧边栏在桌面上的显示方式" Style="{StaticResource CardDescription}" />
          </StackPanel>
        </Grid>
        <Border Height="1" Background="{DynamicResource Divider}" />
        <StackPanel Margin="58,14,16,16">
          <RadioButton x:Name="FixedModeRadio" GroupName="DisplayMode"
                       Style="{StaticResource RadioOption}" Checked="ModeRadio_Checked">
            <StackPanel>
              <TextBlock Text="固定" />
              <TextBlock Text="在屏幕左侧预留空间，窗口不会遮挡侧边栏" Style="{StaticResource CardDescription}" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="FloatingModeRadio" GroupName="DisplayMode" Margin="0,12,0,0"
                       Style="{StaticResource RadioOption}" Checked="ModeRadio_Checked">
            <StackPanel>
              <TextBlock Text="悬浮" />
              <TextBlock Text="不占用屏幕空间，被窗口遮挡时自动让开" Style="{StaticResource CardDescription}" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,4,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xED1A;" Style="{StaticResource CardIcon}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="隐藏其他窗口" />
          <TextBlock Text="桌面上只保留当前应用，其余窗口收进左侧" Style="{StaticResource CardDescription}" />
        </StackPanel>
        <CheckBox x:Name="HideWindowsToggle" Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center"
                  Style="{StaticResource ToggleSwitch}"
                  Checked="HideWindowsToggle_Changed" Unchecked="HideWindowsToggle_Changed" />
      </Grid>
    </Border>

    <TextBlock Text="外观" Style="{StaticResource GroupHeader}" />
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xE740;" Style="{StaticResource CardIcon}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="展示宽度" />
          <TextBlock Text="卡片的最大尺寸，应用多时会自动缩小" Style="{StaticResource CardDescription}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="24,0,0,0" Orientation="Horizontal">
          <TextBlock x:Name="WidthValueText" Style="{StaticResource SliderValue}" />
          <Slider x:Name="WidthSlider" Style="{StaticResource FluentSlider}"
                  Minimum="100" Maximum="420" TickFrequency="10" SmallChange="10" LargeChange="20"
                  ValueChanged="Slider_ValueChanged" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,4,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="&#xECA5;" Style="{StaticResource CardIcon}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="图标大小" />
          <TextBlock Text="侧边栏中应用图标的大小" Style="{StaticResource CardDescription}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="24,0,0,0" Orientation="Horizontal">
          <TextBlock x:Name="IconSizeValueText" Style="{StaticResource SliderValue}" />
          <Slider x:Name="IconSizeSlider" Style="{StaticResource FluentSlider}"
                  Minimum="60" Maximum="160" TickFrequency="10" SmallChange="10" LargeChange="20"
                  ValueChanged="Slider_ValueChanged" />
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</Window>
